{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XIX-SVGConverter",
  "version": "0.1.1",
  "identifier": "net.xixlabs.svgconverter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "XIX-SVGConverter",
        "width": 300,
        "height": 600,
        "minWidth": 300,
        "maxWidth": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": ["inkscape-portable/"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4MkQ3QkRDNERBODA0Q0EKUldUS0JLaE4zSHN0T011SHVOcmpoZW1tYythVlRObnBueDhNNEs5TlVMZm1zUWZYR002L0ZKVFkK",
      "endpoints": [
        "https://github.com/mfahryf/XIX-SVGConverter-release/releases/latest/download/latest.json"
      ]
    }
  }
}
